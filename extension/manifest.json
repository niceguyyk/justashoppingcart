{
  "manifest_version": 3,
  "name": "Just a Shopping Cart",
  "version": "1.0.0",
  "description": "Send the current product page to your shopping cart.",
  "permissions": ["activeTab"],
  "action": {
    "default_title": "Add to Just a Shopping Cart",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@jashc.vyrontechnologies.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["browsingActivity"]
      }
    }
  }
}
